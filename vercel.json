{
  "functions": {
    "api/index.ts": {
      "maxDuration": 60
    }
  },
  "rewrites": [
    {
      "source": "/(.*)",
      "destination": "/api/index"
    }
  ],
  "crons": [
    {
      "path": "/api/reports/daily-learning",
      "schedule": "0 12 * * *"
    },
    {
      "path": "/api/reports/daily-email",
      "schedule": "0 13 * * *"
    }
  ]
}
